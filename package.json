{
  "name": "angelmind-control-plane",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts server/worker.ts server/scheduled.ts --platform=node --packages=external --bundle --format=esm --external:./vite --outdir=dist",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:migration-journal": "node scripts/check-migration-journal.mjs",
    "check:migration-safety": "node scripts/check-migration-safety.mjs",
    "check:migration-rollback": "node scripts/check-migration-rollback.mjs",
    "check:master-contract": "node scripts/check-master-contract.mjs",
    "check:execution-contract": "pnpm exec vitest run server/tool-execution-pipeline.test.ts server/tool-runtime.test.ts",
    "check:provider-neutral": "node scripts/check-provider-neutral.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:staging": "node scripts/run-staging-verification.mjs",
    "start": "NODE_ENV=production node dist/_core/index.js",
    "start:worker": "NODE_ENV=production RUN_WORKER=true node dist/worker.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "api:cli": "tsx scripts/angelmind-api-cli.ts",
    "test:e2e": "playwright test",
    "test:python": "python3 -m pytest -q research-service/tests",
    "lint:python": "python3 -m ruff check research-service",
    "db:push": "drizzle-kit generate && drizzle-kit migrate"
  },
