# Railway database or compatible MySQL/TiDB connection
DATABASE_URL=mysql://user:password@localhost:3306/angelmind

# Server-only secrets; keep values in a secret manager
APP_ENCRYPTION_KEY=
AUDIT_ARCHIVE_SIGNING_KEY=

# Firebase browser configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Firebase Admin configuration (server-side token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
ADMIN_FIREBASE_UIDS=

# Supabase Storage (server only; never expose the service-role key as VITE_*)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=angelmind-files

# Public application URL used in email links
APP_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=

# Railway Cron callback authentication
RAILWAY_CRON_SECRET=replace-with-a-different-long-random-secret

# Optional comma-separated runtime binaries required by /readyz in production.
# Example: yara,bandit,trivy
RUNTIME_REQUIRED_BINARIES=

# Optional outbound notification webhook
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# OpenAI-compatible LLM provider; all keys remain server-side
LLM_PRIMARY_API_BASE_URL=https://api.example.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_FALLBACK_API_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional generic SMTP email delivery (server-side only)
# Use SMTP_SECURE=true for implicit TLS, commonly port 465; false for STARTTLS, commonly port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AngelMind <no-reply@example.com>"
SMTP_SECURE=false
SMTP_TIMEOUT_MS=10000
