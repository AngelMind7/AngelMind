FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN useradd --create-home --shell /usr/sbin/nologin angelmind
COPY apps/orchestrator-langgraph ./apps/orchestrator-langgraph
RUN python -m pip install --no-cache-dir ./apps/orchestrator-langgraph \
    && chown -R angelmind:angelmind /app

USER angelmind
CMD ["python", "-c", "import checkdmarc, dns; print('AngelMind Python passive runtime ready')"]
